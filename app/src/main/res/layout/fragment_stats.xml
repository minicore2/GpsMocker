<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📍 模擬狀態" android:textColor="#888" android:textSize="11sp"
                    android:textAllCaps="true" android:letterSpacing="0.1"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <View android:id="@+id/statusDot" android:layout_width="12dp" android:layout_height="12dp"
                        android:background="@drawable/dot_grey"/>

                    <TextView android:id="@+id/tvStatusLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="待機" android:textColor="@color/text_secondary"
                        android:textSize="14sp" android:layout_marginStart="8dp"/>

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                    <TextView android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/accent" android:textSize="14sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <TextView android:id="@+id/tvCurrentCoord"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/text_primary"
                    android:textSize="12sp" android:fontFamily="monospace"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Steps card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="👟 步數統計"
                        android:textColor="#888" android:textSize="11sp"
                        android:textAllCaps="true" android:letterSpacing="0.1"/>

                    <TextView android:id="@+id/tvBackendBadge"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💾 本地" android:textColor="@color/accent"
                        android:textSize="11sp" android:background="@drawable/badge_bg"
                        android:paddingHorizontal="8dp" android:paddingVertical="2dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvTodaySteps"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/accent"
                            android:textSize="32sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="今日總步數" android:textColor="#888" android:textSize="11sp"/>
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent"
                        android:background="#2A3050"/>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvSessionSteps"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/green"
                            android:textSize="32sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="本次步數" android:textColor="#888" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshSteps"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:text="🔄 重新讀取步數"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Session distance card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📏 本次路程" android:textColor="#888" android:textSize="11sp"
                    android:textAllCaps="true" android:letterSpacing="0.1"/>

                <TextView android:id="@+id/tvSessionDist"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="0 m" android:textColor="@color/text_primary"
                    android:textSize="28sp" android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

                <TextView android:id="@+id/tvSegmentInfo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/text_secondary"
                    android:textSize="12sp" android:fontFamily="monospace"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
